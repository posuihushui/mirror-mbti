ADMIN_URL=http://localhost:3001
# Existing mirror database, never a different empty database. Use a dedicated role (see README).
ADMIN_DATABASE_URL=postgres://mirror_admin:change-me@localhost:5432/mirror
ADMIN_USERNAME=admin
# Generate with npm run admin:password (interactive, hidden input).
ADMIN_PASSWORD_HASH=
# Independent of the public site's SESSION_SECRET. At least 32 random characters.
ADMIN_SESSION_SECRET=

# Optional Telegram bot. Never commit the token. No domain or inbound port is required.
TELEGRAM_BOT_TOKEN=
# Private chat ID recommended. Send /start to your bot before running the worker.
TELEGRAM_ADMIN_CHAT_ID=
# Optional for private chat; required in a group. Comma-separated numeric user IDs.
TELEGRAM_ALLOWED_USER_IDS=
# Default false: only real orders trigger pushes. Set true to test mock checkout end-to-end.
TELEGRAM_INCLUDE_MOCK=false
