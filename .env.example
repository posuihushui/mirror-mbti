# 站点公网地址（用于 canonical / OG / 支付回调）
APP_URL=http://localhost:3000

# Postgres 连接串（docker compose 默认值见 docker-compose.yml）
DATABASE_URL=postgres://mirror:mirror@localhost:5432/mirror

# 访客 cookie 签名密钥，至少 32 个随机字符：openssl rand -base64 32
SESSION_SECRET=change-me-to-a-random-string-at-least-32-chars

# 支付：mock（默认，演示不扣款）| wechat（微信支付 APIv3）
PAYMENT_PROVIDER=mock
# 完整报告价格（分）
PRICE_FEN=690

# ---- 微信支付 APIv3（PAYMENT_PROVIDER=wechat 时必填）----
WECHAT_PAY_MCHID=
WECHAT_PAY_APPID=
WECHAT_PAY_SERIAL_NO=
# 商户 API 私钥（PEM，多行请用 \n 转义或直接粘贴）
WECHAT_PAY_PRIVATE_KEY=
WECHAT_PAY_APIV3_KEY=
# 微信支付公钥 ID 与公钥（PEM）；使用平台证书模式时留空，系统会自动拉取平台证书
WECHAT_PAY_PUBLIC_KEY_ID=
WECHAT_PAY_PUBLIC_KEY=
# 回调地址，默认 ${APP_URL}/api/payments/wechat/notify
WECHAT_PAY_NOTIFY_URL=

# ---- 微信公众号（JSAPI 支付 openid、JS-SDK 分享，可选）----
WECHAT_MP_APPID=
WECHAT_MP_SECRET=
