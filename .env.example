# 站点公网地址（用于 canonical / OG / 支付回调）
APP_URL=http://localhost:3000

# Postgres 连接串（docker compose 默认值见 docker-compose.yml）
DATABASE_URL=postgres://mirror:mirror@localhost:5432/mirror

# 访客 cookie 签名密钥，至少 32 个随机字符：openssl rand -base64 32
SESSION_SECRET=change-me-to-a-random-string-at-least-32-chars

# 支付：mock（默认，演示不扣款）| wechat（微信支付 APIv3）
PAYMENT_PROVIDER=mock
# 完整报告价格（分）
PRICE_FEN=690

# ---- 微信支付 APIv3（PAYMENT_PROVIDER=wechat 时必填）----
WECHAT_PAY_MCHID=
WECHAT_PAY_APPID=
WECHAT_PAY_SERIAL_NO=
# 商户 API 私钥（PEM，多行请用 \n 转义或直接粘贴）
WECHAT_PAY_PRIVATE_KEY=
WECHAT_PAY_APIV3_KEY=
# 微信支付公钥 ID 与公钥（PEM）；使用平台证书模式时留空，系统会自动拉取平台证书
WECHAT_PAY_PUBLIC_KEY_ID=
WECHAT_PAY_PUBLIC_KEY=
# 回调地址，默认 ${APP_URL}/api/payments/wechat/notify
WECHAT_PAY_NOTIFY_URL=

# ---- 微信公众号（JSAPI 支付 openid、JS-SDK 分享，可选）----
WECHAT_MP_APPID=
WECHAT_MP_SECRET=

# ---- 英文站 /en：USDT / USDC 收款 ----
# mock（默认，演示不扣款）| crypto（链上收款，无第三方网关）
EN_PAYMENT_PROVIDER=mock
# 英文完整报告价格（美分），100 = $1；链上需到账不少于该金额
PRICE_USD_CENTS=100
# 每条网络需同时配置收款地址与 RPC 才会在结账中出现
# Ethereum：付款人先用钱包免费签名确认地址，再从该地址转账
CRYPTO_EVM_RECEIVER=
ETHEREUM_RPC_URL=
# 1 = 主网；测试网（如 11155111 Sepolia）需同时填写下方两个代币合约地址
ETHEREUM_CHAIN_ID=1
ETHEREUM_CONFIRMATIONS=3
ETHEREUM_USDC_ADDRESS=
ETHEREUM_USDT_ADDRESS=
# Solana：Solana Pay 付款请求，每单独立 reference
CRYPTO_SOLANA_RECEIVER=
SOLANA_RPC_URL=
# devnet 测试时可覆盖代币 mint，留空使用主网 USDC / USDT
SOLANA_USDC_MINT=
SOLANA_USDT_MINT=

# ---- Google Analytics 4（可选）----
# 衡量 ID（G- 开头），构建时写入客户端代码；留空则不加载 GA。埋点清单见 docs/analytics.md
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Enable only after public sharing is verified with the configured WeChat account.
WECHAT_SHARE_ENABLED=false
