{
  "name": "mirror-mbti",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @mirror/web --",
    "build": "npm run build --workspaces --if-present --",
    "build:web": "npm run build --workspace @mirror/web --",
    "start": "npm run start --workspace @mirror/web --",
    "start:next": "npm run start:next --workspace @mirror/web --",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:integration": "vitest run --config vitest.share-integration.config.mts",
    "test:admin": "vitest run --config vitest.admin-integration.config.mts",
    "admin:dev": "npm run dev --workspace @mirror/admin --",
    "admin:build": "npm run build --workspace @mirror/admin --",
    "admin:start": "npm run start --workspace @mirror/admin --",
    "admin:typecheck": "npm run typecheck --workspace @mirror/admin --",
    "admin:password": "npm run password --workspace @mirror/admin --",
    "admin:telegram": "npm run telegram --workspace @mirror/admin --",
    "db:generate": "npm run generate --workspace @mirror/db --",
    "db:migrate": "npm run migrate --workspace @mirror/db --",
    "db:studio": "npm run studio --workspace @mirror/db --",
    "db:report:shares": "npm run report:shares --workspace @mirror/db --",
    "db:cleanup:shares": "npm run cleanup:shares --workspace @mirror/db --",
    "db:cleanup:admin": "npm run cleanup:admin --workspace @mirror/db --",
    "analyze": "npm run analyze --workspace @mirror/web --",
    "optimize:images": "npm run optimize:images --workspace @mirror/web --",
    "brand:build": "npm run brand:build --workspace @mirror/web --",
    "fonts:build": "npm run fonts:build --workspace @mirror/web --"
  },
  "devDependencies": {
    "@next/env": "16.3.4",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
